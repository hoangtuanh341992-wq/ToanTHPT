{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DoretaExamFirestoreSchema",
  "description": "Firestore schema for Doreta's Exam System",
  "entities": {
    "system_settings": {
      "title": "SystemSettings",
      "description": "Global settings like admin PIN",
      "properties": {
        "adminPin": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["adminPin"]
    },
    "exams": {
      "title": "Exam",
      "description": "Published and draft exams",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "accessCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "questions": { "type": "array" },
        "totalQuestions": { "type": "number" }
      },
      "required": ["id", "title", "questions"]
    },
    "question_bank": {
      "title": "QuestionBankItem",
      "description": "Shared questions in question bank",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "stem": { "type": "string" },
        "grade": { "type": "string" },
        "level": { "type": "string" },
        "topic": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "stem"]
    },
    "exam_results": {
      "title": "ExamResult",
      "description": "Student exam submissions",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "examCode": { "type": "string" },
        "studentName": { "type": "string" },
        "studentClass": { "type": "string" },
        "score": { "type": "number" },
        "submittedAt": { "type": "string" },
        "tabSwitchCount": { "type": "number" }
      },
      "required": ["id", "studentName", "score", "submittedAt"]
    }
  }
}
